# =============================================================================
# Frontend environment variables (book/)
# Copy to .env.local for local dev. On Vercel: Project → Settings → Environment Variables
# =============================================================================

# REQUIRED on Vercel — public URL of your deployed FastAPI backend (no trailing slash)
# Example: https://booking-api.railway.app  or  https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# REQUIRED on Vercel — your live site URL (metadata, Open Graph)
# Example: https://your-app.vercel.app  or  https://www.yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL — proxy target for /backend/* rewrites (login, admin, API)
# Local Docker frontend: http://backend:4000
# Vercel + external backend: same value as NEXT_PUBLIC_API_URL
# Local npm run dev: http://127.0.0.1:4000
BACKEND_INTERNAL_URL=http://127.0.0.1:4000

# -----------------------------------------------------------------------------
# VERCEL CHECKLIST (set in dashboard before first deploy)
# -----------------------------------------------------------------------------
# 1. Root Directory: book
# 2. Framework Preset: Next.js (auto-detected)
# 3. Environment variables (Production + Preview):
#      NEXT_PUBLIC_API_URL     = https://YOUR-BACKEND-URL
#      NEXT_PUBLIC_SITE_URL    = https://YOUR-VERCEL-URL.vercel.app
#      BACKEND_INTERNAL_URL    = https://YOUR-BACKEND-URL   (same as API URL)
# 4. Redeploy after changing env vars (rewrites are resolved at build time)
#
# Backend must also allow your Vercel origin:
#   CORS_ORIGIN=https://your-app.vercel.app
#   FRONTEND_URL=https://your-app.vercel.app
#   COOKIE_SECURE=true
