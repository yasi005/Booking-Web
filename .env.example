# =============================================================================
# Frontend environment variables (book/)
# Copy to .env.local for local dev. On Vercel: Project → Settings → Environment Variables
# =============================================================================

# REQUIRED on Vercel — public URL of your deployed FastAPI backend (no trailing slash)
# Example: https://YOUR-SERVICE.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:4000

# REQUIRED on Vercel — your live site URL (metadata, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL — proxy target for /backend/* rewrites (login, admin, API)
# Local Docker frontend: http://backend:4000
# Vercel + external backend: same value as NEXT_PUBLIC_API_URL
# Local npm run dev: http://127.0.0.1:4000
BACKEND_INTERNAL_URL=http://127.0.0.1:4000

# -----------------------------------------------------------------------------
# VERCEL PRODUCTION (book.yazmin.dev)
# -----------------------------------------------------------------------------
# 1. Root Directory: book
# 2. Framework Preset: Next.js
# 3. Environment variables (Production):
#      NEXT_PUBLIC_API_URL     = https://YOUR-SERVICE.up.railway.app
#      NEXT_PUBLIC_SITE_URL    = https://book.yazmin.dev
#      BACKEND_INTERNAL_URL    = https://YOUR-SERVICE.up.railway.app
# 4. Redeploy after changing env vars
#
# Backend Railway vars must include:
#   CORS_ORIGIN=https://book.yazmin.dev
#   FRONTEND_URL=https://book.yazmin.dev
#   COOKIE_SECURE=true
